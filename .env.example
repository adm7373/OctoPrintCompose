# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored so serial paths and settings are never committed.

# Timezone used by the containers (Region/City, no spaces).
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ---------------------------------------------------------------------------
# HOST PORTS
# OctoPrint listens on 80 inside each container; these are the ports you use in
# the browser. Change them if something else already owns 5000/5001.
# ---------------------------------------------------------------------------
CR6SE_PORT=5000
ENDER3PRO_PORT=5001

# ---------------------------------------------------------------------------
# SERIAL DEVICES  (required — `docker compose up` fails without them)
#
# Run:  sudo ./scripts/find-printers.sh
# It prints the values to use. The defaults below are placeholders that will
# NOT exist on a fresh install, which is intentional: compose should fail loudly
# rather than silently attaching to the wrong printer.
#
# The symlinks are created by udev/99-octoprint-serial.rules, which identifies
# each printer by the USB port it is plugged into.
# ---------------------------------------------------------------------------
CR6SE_SERIAL_DEVICE=/dev/octoprint-cr6se
ENDER3PRO_SERIAL_DEVICE=/dev/octoprint-e3pro

# ---------------------------------------------------------------------------
# CAMERA (optional)
# Set to true only if you attach a USB webcam AND uncomment the /dev/video0
# device mapping in docker-compose.yml. The official image streams via
# mjpg-streamer; the Raspberry Pi Camera Module is not supported by that path.
# ---------------------------------------------------------------------------
ENABLE_MJPG_STREAMER=false
CAMERA_DEV=/dev/video0

# ---------------------------------------------------------------------------
# UPLOADS / TIMELAPSE (optional)
# Where timelapse videos and uploads are kept. Point this at a drive with room
# and uncomment the matching volumes in docker-compose.yml. Default keeps them
# on the SD card, which fills up quickly with video.
# ---------------------------------------------------------------------------
UPLOADS_PATH=/mnt/storage/octoprint
